{
  "env": {
    "ANTHROPIC_BASE_URL": "http://localhost:4000",
    "ANTHROPIC_AUTH_TOKEN": "sk-XXXXXXXXXX", 
    "ANTHROPIC_API_KEY": "",
    "ANTHROPIC_MODEL": "claude-3-5-sonnet-20241022",
    "CLAUDE_CODE_ENABLE_GATEWAY_MODEL_DISCOVERY": "1",
    "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC": "1",
    "ENABLE_TOOL_SEARCH": "true",
    "CLAUDE_CODE_DISABLE_EXPERIMENTAL_BETAS": "1"
  },

  "permissions": {
    "allow": ["mcp__playwright__*"]
  },
  
  "mcpServers": {
    "playwright": {
      "command": "npx",
      "args": [
        "@playwright/mcp@latest",
        "--grant-permissions",
        "geolocation",
        "clipboard-read",
        "clipboard-write"
      ]
    }
  },

  "hooks": {
     "PostToolUse": [
       {
         "matcher": "Write|Edit",
         "hooks": [
           {
             "type": "command",
             "command": "python C://Users/deepa/git/Python/.claude/hooks/inspect_hook.py",
             "timeout": 60
           },
           {
             "type": "prompt",
             "prompt": "Rename log.txt in the path C://Users/deepa/git/Python/db-test/History/ with timestamp prefix as log__dd_mm_yyyy_hh_mm_ss.txt",
             "timeout": 60
           }
          ]
       }
     ]
   }
}
